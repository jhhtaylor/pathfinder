{
  "name": "pathfinder-code-paths",
  "displayName": "Pathfinder - Code Paths",
  "publisher": "jhhtaylor",
  "author": {
    "name": "Jon Taylor",
    "email": "jhhtaylor@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jhhtaylor/pathfinder"
  },
  "sponsor": {
    "url": "https://www.buymeacoffee.com/jhhtaylor"
  },
  "description": "Track and navigate through code logic flows by marking lines of code",
  "icon": "media/pathfinder.png",
  "galleryBanner": {
    "color": "#FF914D",
    "theme": "dark"
  },
  "version": "0.3.3",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "Code Navigation",
    "Bookmarks",
    "Code Flow",
    "Tracing",
    "Navigation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pathfinder.addToCodePath",
        "category": "Pathfinder",
        "title": "Add to Code Path...",
        "icon": "$(plus)"
      },
      {
        "command": "pathfinder.createNewPath",
        "category": "Pathfinder",
        "title": "Create New Code Path",
        "icon": "$(add)"
      },
      {
        "command": "pathfinder.deletePath",
        "category": "Pathfinder",
        "title": "Delete Code Path",
        "icon": "$(trash)"
      },
      {
        "command": "pathfinder.renamePath",
        "category": "Pathfinder",
        "title": "Rename Code Path...",
        "icon": "$(pencil)"
      },
      {
        "command": "pathfinder.navigateToStep",
        "category": "Pathfinder",
        "title": "Navigate to Step",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pathfinder.removeStep",
        "category": "Pathfinder",
        "title": "Remove Step",
        "icon": "$(trash)"
      },
      {
        "command": "pathfinder.renameStep",
        "category": "Pathfinder",
        "title": "Rename Step...",
        "icon": "$(pencil)"
      },
      {
        "command": "pathfinder.nextStep",
        "category": "Pathfinder",
        "title": "Go to Next Step",
        "icon": "$(arrow-down)"
      },
      {
        "command": "pathfinder.previousStep",
        "category": "Pathfinder",
        "title": "Go to Previous Step",
        "icon": "$(arrow-up)"
      },
      {
        "command": "pathfinder.playPath",
        "category": "Pathfinder",
        "title": "Play Code Path",
        "icon": "$(play)"
      },
      {
        "command": "pathfinder.pausePlayPath",
        "category": "Pathfinder",
        "title": "Pause Playing Code Path",
        "icon": "$(debug-pause)"
      },
      {
        "command": "pathfinder.resumePlayPath",
        "category": "Pathfinder",
        "title": "Resume Playing Code Path",
        "icon": "$(play)"
      },
      {
        "command": "pathfinder.stopPlayPath",
        "category": "Pathfinder",
        "title": "Stop Playing Code Path",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pathfinder.exportCodePaths",
        "category": "Pathfinder",
        "title": "Export Code Paths...",
        "icon": "$(arrow-up)"
      },
      {
        "command": "pathfinder.importCodePaths",
        "category": "Pathfinder",
        "title": "Import Code Paths...",
        "icon": "$(desktop-download)"
      },
      {
        "command": "pathfinder.collapseAll",
        "category": "Pathfinder",
        "title": "Collapse All Code Paths",
        "icon": "$(collapse-all)"
      },
      {
        "command": "pathfinder.expandAll",
        "category": "Pathfinder",
        "title": "Expand All Code Paths",
        "icon": "$(expand-all)"
      },
      {
        "command": "pathfinder.showMoreOptions",
        "category": "Pathfinder",
        "title": "More Options...",
        "icon": "$(ellipsis)"
      },
      {
        "command": "pathfinder.callHierarchy.setDepth3",
        "category": "Pathfinder",
        "title": "Depth: 3 Levels",
        "icon": "$(list-tree)"
      },
      {
        "command": "pathfinder.callHierarchy.setDepthAll",
        "category": "Pathfinder",
        "title": "Depth: All Levels",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "pathfinder.callHierarchy.refresh",
        "category": "Pathfinder",
        "title": "Refresh Call Hierarchy",
        "icon": "$(refresh)"
      },
      {
        "command": "pathfinder.callHierarchy.navigateToNode",
        "category": "Pathfinder",
        "title": "Navigate to Method",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pathfinder.callHierarchy.goToDefinition",
        "category": "Pathfinder",
        "title": "Go to Definition",
        "icon": "$(go-to-file)"
      },
      {
        "command": "pathfinder.callHierarchy.addToCodePath",
        "category": "Pathfinder",
        "title": "Add to Code Path...",
        "icon": "$(plus)"
      },
      {
        "command": "pathfinder.callHierarchy.debugDump",
        "category": "Pathfinder",
        "title": "Call Hierarchy: Debug Dump"
      },
      {
        "command": "pathfinder.importFromExplorer",
        "category": "Pathfinder",
        "title": "Import into Pathfinder"
      },
      {
        "command": "pathfinder.goToStep",
        "category": "Pathfinder",
        "title": "Go to Step"
      },
      {
        "command": "pathfinder.toggleStepReviewed",
        "category": "Pathfinder",
        "title": "Toggle Step Reviewed",
        "icon": "$(check)"
      },
      {
        "command": "pathfinder.openStepChanges",
        "category": "Pathfinder",
        "title": "Open Changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "pathfinder.showPathMap",
        "category": "Pathfinder",
        "title": "Show Path Map",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "pathfinder.copyAsMermaid",
        "category": "Pathfinder",
        "title": "Copy as Mermaid Diagram",
        "icon": "$(copy)"
      },
      {
        "command": "pathfinder.editPathSummary",
        "category": "Pathfinder",
        "title": "Edit Summary...",
        "icon": "$(note)"
      },
      {
        "command": "pathfinder.copyStepWithCode",
        "category": "Pathfinder",
        "title": "Copy Step With Code"
      },
      {
        "command": "pathfinder.copyRelativePath",
        "category": "Pathfinder",
        "title": "Copy Relative Path"
      },
      {
        "command": "pathfinder.copyRelativePathWithLine",
        "category": "Pathfinder",
        "title": "Copy Relative Path With Line"
      },
      {
        "command": "pathfinder.copyPath",
        "category": "Pathfinder",
        "title": "Copy Path"
      },
      {
        "command": "pathfinder.copyFileName",
        "category": "Pathfinder",
        "title": "Copy File Name"
      },
      {
        "command": "pathfinder.copyFileNameWithExtension",
        "category": "Pathfinder",
        "title": "Copy File Name With Extension"
      },
      {
        "command": "pathfinder.copyAtMention",
        "category": "Pathfinder",
        "title": "Copy as @ Mention"
      },
      {
        "command": "pathfinder.copyRepoName",
        "category": "Pathfinder",
        "title": "Copy Repo Name"
      },
      {
        "command": "pathfinder.copyPathStepsWithCode",
        "category": "Pathfinder",
        "title": "Copy Steps With Code"
      },
      {
        "command": "pathfinder.copyPathFilePaths",
        "category": "Pathfinder",
        "title": "Copy File Paths"
      },
      {
        "command": "pathfinder.setStepKind",
        "category": "Pathfinder",
        "title": "Set Kind...",
        "icon": "$(tag)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pathfinder",
          "title": "Pathfinder",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pathfinder": [
        {
          "id": "pathfinderCallHierarchy",
          "name": "Call Hierarchy"
        },
        {
          "id": "pathfinder",
          "name": "Code Paths"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "pathfinder.importCodePaths",
          "when": "view == pathfinder",
          "group": "navigation@0"
        },
        {
          "command": "pathfinder.createNewPath",
          "when": "view == pathfinder",
          "group": "navigation@1"
        },
        {
          "command": "pathfinder.collapseAll",
          "when": "view == pathfinder && !pathfinder:allCollapsed",
          "group": "navigation@2"
        },
        {
          "command": "pathfinder.expandAll",
          "when": "view == pathfinder && pathfinder:allCollapsed",
          "group": "navigation@2"
        },
        {
          "command": "pathfinder.showMoreOptions",
          "when": "view == pathfinder",
          "group": "navigation@3"
        },
        {
          "command": "pathfinder.callHierarchy.setDepth3",
          "when": "view == pathfinderCallHierarchy",
          "group": "navigation@0"
        },
        {
          "command": "pathfinder.callHierarchy.setDepthAll",
          "when": "view == pathfinderCallHierarchy",
          "group": "navigation@2"
        },
        {
          "command": "pathfinder.callHierarchy.refresh",
          "when": "view == pathfinderCallHierarchy",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "pathfinder.addToCodePath",
          "group": "pathfinder@1"
        }
      ],
      "view/item/context": [
        {
          "command": "pathfinder.renamePath",
          "when": "view == pathfinder && viewItem == path",
          "group": "inline@1"
        },
        {
          "command": "pathfinder.playPath",
          "when": "view == pathfinder && viewItem == path && !pathfinder:isPlaying",
          "group": "inline@2"
        },
        {
          "command": "pathfinder.pausePlayPath",
          "when": "view == pathfinder && pathfinder:isPlaying && !pathfinder:isPaused",
          "group": "inline@2"
        },
        {
          "command": "pathfinder.resumePlayPath",
          "when": "view == pathfinder && pathfinder:isPlaying && pathfinder:isPaused",
          "group": "inline@2"
        },
        {
          "command": "pathfinder.stopPlayPath",
          "when": "view == pathfinder && pathfinder:isPlaying",
          "group": "inline@2"
        },
        {
          "command": "pathfinder.deletePath",
          "when": "view == pathfinder && viewItem == path",
          "group": "inline@3"
        },
        {
          "command": "pathfinder.navigateToStep",
          "when": "view == pathfinder && viewItem == step",
          "group": "inline@0"
        },
        {
          "command": "pathfinder.renameStep",
          "when": "view == pathfinder && viewItem == step",
          "group": "inline@1"
        },
        {
          "command": "pathfinder.removeStep",
          "when": "view == pathfinder && viewItem == step",
          "group": "inline@2"
        },
        {
          "command": "pathfinder.renameStep",
          "when": "view == pathfinder && viewItem == step",
          "group": "stepactions@0"
        },
        {
          "command": "pathfinder.callHierarchy.navigateToNode",
          "when": "view == pathfinderCallHierarchy && (viewItem == callNodeRoot || viewItem == callNode)",
          "group": "inline@0"
        },
        {
          "command": "pathfinder.callHierarchy.goToDefinition",
          "when": "view == pathfinderCallHierarchy && (viewItem == callNodeRoot || viewItem == callNode)",
          "group": "callhierarchy@0"
        },
        {
          "command": "pathfinder.callHierarchy.addToCodePath",
          "when": "view == pathfinderCallHierarchy && (viewItem == callNodeRoot || viewItem == callNode)",
          "group": "callhierarchy@1"
        },
        {
          "command": "pathfinder.showPathMap",
          "when": "view == pathfinder && viewItem == path",
          "group": "inline@0"
        },
        {
          "command": "pathfinder.editPathSummary",
          "when": "view == pathfinder && viewItem == path",
          "group": "pathactions@0"
        },
        {
          "command": "pathfinder.showPathMap",
          "when": "view == pathfinder && viewItem == path",
          "group": "pathactions@1"
        },
        {
          "command": "pathfinder.setStepKind",
          "when": "view == pathfinder && viewItem == step",
          "group": "stepactions@1"
        },
        {
          "command": "pathfinder.openStepChanges",
          "when": "view == pathfinder && viewItem == step",
          "group": "stepactions@2"
        },
        {
          "submenu": "pathfinder.stepCopy",
          "when": "view == pathfinder && viewItem == step",
          "group": "stepcopy@0"
        },
        {
          "submenu": "pathfinder.pathCopy",
          "when": "view == pathfinder && viewItem == path",
          "group": "pathcopy@0"
        }
      ],
      "commandPalette": [
        {
          "command": "pathfinder.addToCodePath"
        },
        {
          "command": "pathfinder.createNewPath"
        },
        {
          "command": "pathfinder.nextStep"
        },
        {
          "command": "pathfinder.previousStep"
        },
        {
          "command": "pathfinder.navigateToStep",
          "when": "false"
        },
        {
          "command": "pathfinder.removeStep",
          "when": "false"
        },
        {
          "command": "pathfinder.renameStep",
          "when": "false"
        },
        {
          "command": "pathfinder.deletePath",
          "when": "false"
        },
        {
          "command": "pathfinder.renamePath",
          "when": "false"
        },
        {
          "command": "pathfinder.playPath",
          "when": "false"
        },
        {
          "command": "pathfinder.pausePlayPath"
        },
        {
          "command": "pathfinder.resumePlayPath"
        },
        {
          "command": "pathfinder.stopPlayPath"
        },
        {
          "command": "pathfinder.exportCodePaths"
        },
        {
          "command": "pathfinder.importCodePaths"
        },
        {
          "command": "pathfinder.collapseAll",
          "when": "false"
        },
        {
          "command": "pathfinder.expandAll",
          "when": "false"
        },
        {
          "command": "pathfinder.showMoreOptions"
        },
        {
          "command": "pathfinder.callHierarchy.setDepth3"
        },
        {
          "command": "pathfinder.callHierarchy.setDepthAll"
        },
        {
          "command": "pathfinder.callHierarchy.refresh"
        },
        {
          "command": "pathfinder.callHierarchy.navigateToNode",
          "when": "false"
        },
        {
          "command": "pathfinder.callHierarchy.goToDefinition",
          "when": "false"
        },
        {
          "command": "pathfinder.callHierarchy.addToCodePath",
          "when": "false"
        },
        {
          "command": "pathfinder.callHierarchy.debugDump"
        },
        {
          "command": "pathfinder.importFromExplorer",
          "when": "false"
        },
        {
          "command": "pathfinder.goToStep",
          "when": "false"
        },
        {
          "command": "pathfinder.toggleStepReviewed",
          "when": "false"
        },
        {
          "command": "pathfinder.openStepChanges",
          "when": "false"
        },
        {
          "command": "pathfinder.editPathSummary",
          "when": "false"
        },
        {
          "command": "pathfinder.showPathMap"
        },
        {
          "command": "pathfinder.copyAsMermaid"
        },
        {
          "command": "pathfinder.copyStepWithCode",
          "when": "false"
        },
        {
          "command": "pathfinder.copyRelativePath",
          "when": "false"
        },
        {
          "command": "pathfinder.copyRelativePathWithLine",
          "when": "false"
        },
        {
          "command": "pathfinder.copyPath",
          "when": "false"
        },
        {
          "command": "pathfinder.copyFileName",
          "when": "false"
        },
        {
          "command": "pathfinder.copyFileNameWithExtension",
          "when": "false"
        },
        {
          "command": "pathfinder.copyAtMention",
          "when": "false"
        },
        {
          "command": "pathfinder.copyRepoName",
          "when": "false"
        },
        {
          "command": "pathfinder.copyPathStepsWithCode",
          "when": "false"
        },
        {
          "command": "pathfinder.copyPathFilePaths",
          "when": "false"
        },
        {
          "command": "pathfinder.setStepKind",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "pathfinder.importFromExplorer",
          "when": "resourceExtname == .json",
          "group": "pathfinder@1"
        }
      ],
      "pathfinder.stepCopy": [
        {
          "command": "pathfinder.copyStepWithCode",
          "group": "1_code@0"
        },
        {
          "command": "pathfinder.copyRelativePath",
          "group": "2_path@0"
        },
        {
          "command": "pathfinder.copyRelativePathWithLine",
          "group": "2_path@1"
        },
        {
          "command": "pathfinder.copyPath",
          "group": "2_path@2"
        },
        {
          "command": "pathfinder.copyFileName",
          "group": "3_name@0"
        },
        {
          "command": "pathfinder.copyFileNameWithExtension",
          "group": "3_name@1"
        },
        {
          "command": "pathfinder.copyAtMention",
          "group": "4_mention@0"
        },
        {
          "command": "pathfinder.copyRepoName",
          "group": "5_repo@0"
        }
      ],
      "pathfinder.pathCopy": [
        {
          "command": "pathfinder.copyPathStepsWithCode",
          "group": "1_code@0"
        },
        {
          "command": "pathfinder.copyPathFilePaths",
          "group": "2_path@0"
        },
        {
          "command": "pathfinder.copyAsMermaid",
          "group": "3_diagram@0"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pathfinder.addToCodePath",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "pathfinder.nextStep",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down"
      },
      {
        "command": "pathfinder.previousStep",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up"
      }
    ],
    "configuration": {
      "title": "Pathfinder",
      "properties": {
        "pathfinder.playDelaySeconds": {
          "type": "number",
          "default": 1.5,
          "minimum": 0.5,
          "maximum": 10,
          "description": "Delay in seconds between steps when playing a code path. The default is 1.5 seconds."
        },
        "pathfinder.importExportDirectory": {
          "type": "string",
          "default": "",
          "description": "Directory for importing/exporting code paths. Can be absolute or relative to workspace root. When empty, the import dialog opens in the folder of the active file and export defaults to the workspace root."
        },
        "pathfinder.promptForName": {
          "type": "boolean",
          "default": false,
          "description": "Prompt for a custom name when creating a new code path. When disabled, paths are automatically named 'Code Path 1', 'Code Path 2', etc."
        },
        "pathfinder.callHierarchy.excludeExternalPackages": {
          "type": "boolean",
          "default": true,
          "description": "In the Call Hierarchy view, hide methods that live outside the workspace (e.g. npm packages, SDK standard library calls). Disable to show all outgoing calls including third-party code."
        },
        "pathfinder.showInlineNotes": {
          "type": "boolean",
          "default": true,
          "description": "Show each step's number and note at the end of its line in the editor, with a hover for details and navigation."
        },
        "pathfinder.showReviewCheckboxes": {
          "type": "boolean",
          "default": true,
          "description": "Show a checkbox on each step in the Code Paths view to track which steps you have reviewed."
        },
        "pathfinder.diffBase": {
          "type": "string",
          "default": "",
          "description": "Git ref that Open Changes compares a step's file against. When empty, the merge base of HEAD with origin/main, origin/master, main or master is used, falling back to HEAD."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "pathfinder",
        "contents": "No code paths yet.\n[$(desktop-download) Import Code Paths](command:pathfinder.importCodePaths)\n[$(add) New Code Path](command:pathfinder.createNewPath)\nOr right-click a line in the editor and choose Add to Code Path."
      }
    ],
    "submenus": [
      {
        "id": "pathfinder.stepCopy",
        "label": "Copy"
      },
      {
        "id": "pathfinder.pathCopy",
        "label": "Copy"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node ./out/test/runTest.js",
    "publish:all": "bash scripts/publish.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.33.1",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^9.30.1",
    "glob": "^13.0.0",
    "mocha": "^11.7.5",
    "ovsx": "^1.0.2",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  }
}
